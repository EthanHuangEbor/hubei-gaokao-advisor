{
  "name": "hubei-gaokao-advisor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "test:e2e": "npm --workspace apps/web run test:e2e",
    "api": "uvicorn apps.api.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "fixtures": "python scripts/generate_fixtures.py",
    "test:py": "pytest",
    "lint:py": "ruff check .",
    "typecheck:py": "mypy services apps/api tests"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
